# Mapbox public token (https://account.mapbox.com/). Without it the map shows a friendly notice.
VITE_MAPBOX_TOKEN=
# Serve realistic inversion-shaped fixture data, no network needed.
VITE_USE_MOCK_DATA=false
# Mock mode only: number of simulated map sensors (default 180). Try 5000 to stress-test the map layers.
VITE_MOCK_SENSOR_COUNT=
# Optional PurpleAir READ key. When set (and mock mode is off) PurpleAir replaces Open-Meteo.
# Note: VITE_* values are visible in the browser bundle; restrict the key or proxy it for public deploys.
VITE_PURPLEAIR_API_KEY=
