# Mapbox public token (https://account.mapbox.com/). Without it the map shows a friendly notice.
VITE_MAPBOX_TOKEN=
# Serve realistic inversion-shaped fixture data, no network needed.
VITE_USE_MOCK_DATA=false
# Mock mode only: number of simulated map sensors (default 180). Try 5000 to stress-test the map layers.
VITE_MOCK_SENSOR_COUNT=
# PurpleAir, production: set VITE_PURPLEAIR_PROXY_URL=/api/purpleair on the host and PURPLEAIR_API_KEY (no VITE_ prefix,
# server-only) so the key never reaches the browser. See api/purpleair and the README.
VITE_PURPLEAIR_PROXY_URL=
PURPLEAIR_API_KEY=
# PurpleAir, local development only: a direct READ key. Visible in the browser bundle, so never set it on a public host.
VITE_PURPLEAIR_API_KEY=
